{
  "manifest_version": 3,
  "name": "PHP Version Checker (php2shell)",
  "version": "1.0.0",
  "description": "Checks the PHP version exposed by the current site's response headers against openai/php2shell-checker's vulnerability cutoff table.",
  "permissions": ["webRequest", "webNavigation", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PHP Version Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
